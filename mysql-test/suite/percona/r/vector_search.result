        -> Table scan on t1  (cost=0.55 rows=3) (actual time=X..Y rows=3 loops=1)
    -> Filter: (distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5)  (cost=0.283 rows=1) (actual time=X..Y rows=1 loops=3)
        -> Single-row index lookup on t2 using PRIMARY (id = t1.id)  (cost=0.283 rows=1) (actual time=X..Y rows=1 loops=3)

SELECT /*+ NO_INDEX(t1) */ *
FROM t1 JOIN t2 USING( id )
WHERE distance(t1.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') <= 2.5 AND
distance(t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') <= 2.5;
