CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(3), VECTOR KEY(v));
SHOW CREATE TABLE t1;

--echo # Too short row
--error ER_UNKNOWN_ERROR
INSERT INTO t1 VALUES (1, TO_VECTOR("[1, 2]")); 

--echo # Normal rows
INSERT INTO t1 VALUES (1, TO_VECTOR("[0, 0, 0]")); 
INSERT INTO t1 VALUES (2, TO_VECTOR("[1, 1, 1]")); 
INSERT INTO t1 VALUES (3, TO_VECTOR("[0, 0, 0.1]")); 

SELECT id FROM t1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0, 0]"), "EUCLIDEAN") LIMIT 10;
--replace_regex /actual time=[0-9.e+-]+ /actual time=X..Y /
EXPLAIN ANALYZE SELECT id FROM t1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0, 0]"), "EUCLIDEAN") LIMIT 10;

DROP TABLE t1;
