CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(3), VECTOR KEY(v));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(3) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Too short row
INSERT INTO t1 VALUES (1, TO_VECTOR("[1, 2]"));
ERROR HY000: Unknown error
# Normal rows
INSERT INTO t1 VALUES (1, TO_VECTOR("[0, 0, 0]"));
INSERT INTO t1 VALUES (2, TO_VECTOR("[1, 1, 1]"));
INSERT INTO t1 VALUES (3, TO_VECTOR("[0, 0, 0.1]"));
SELECT id FROM t1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0, 0]"), "EUCLIDEAN") LIMIT 10;
id
1
3
2
EXPLAIN ANALYZE SELECT id FROM t1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0, 0]"), "EUCLIDEAN") LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=0.55 rows=3) (actual time=X..Y rows=3 loops=1)
    -> Vector index search on t1 using v  (cost=0.55 rows=3) (actual time=X..Y rows=3 loops=1)

# Check that changes to index are persisted.
# restart
SELECT id FROM t1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0, 0]"), "EUCLIDEAN") LIMIT 10;
id
1
3
2
EXPLAIN ANALYZE SELECT id FROM t1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0, 0]"), "EUCLIDEAN") LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=0.35 rows=1) (actual time=X..Y rows=3 loops=1)
    -> Vector index search on t1 using v  (cost=0.35 rows=1) (actual time=X..Y rows=3 loops=1)

DROP TABLE t1;
# Test that filtering works correctly with vector search.
# I.e. that ORDER BY distance LIMIT n returns enough rows
# even if some rows returned by vector index are filtered
# out by WHERE clause.
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(2), flag BOOL, VECTOR KEY(v));
INSERT INTO t2 VALUES (1, TO_VECTOR("[0, 0]"), 0);
INSERT INTO t2 VALUES (2, TO_VECTOR("[1, 0]"), 1);
INSERT INTO t2 VALUES (3, TO_VECTOR("[0, 2]"), 1);
INSERT INTO t2 VALUES (4, TO_VECTOR("[3, 0]"), 0);
INSERT INTO t2 VALUES (5, TO_VECTOR("[0, 4]"), 0);
INSERT INTO t2 VALUES (6, TO_VECTOR("[5, 0]"), 1);
INSERT INTO t2 VALUES (7, TO_VECTOR("[0, 6]"), 1);
INSERT INTO t2 VALUES (8, TO_VECTOR("[7, 0]"), 0);
INSERT INTO t2 VALUES (9, TO_VECTOR("[0, 8]"), 0);
INSERT INTO t2 VALUES (10, TO_VECTOR("[9, 0]"), 1);
SELECT id FROM t2 WHERE flag=1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 3;
id
2
3
6
EXPLAIN ANALYZE SELECT id FROM t2 WHERE flag=1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=1.25 rows=1) (actual time=X..Y rows=3 loops=1)
    -> Filter: (t2.flag = 1)  (cost=1.25 rows=1) (actual time=X..Y rows=3 loops=1)
        -> Vector index search on t2 using v  (cost=1.25 rows=1) (actual time=X..Y rows=6 loops=1)

EXPLAIN ANALYZE SELECT id FROM t2 WHERE flag=1 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") DESC LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=1.25 rows=3) (actual time=X..Y rows=3 loops=1)
    -> Sort: distance(t2.v,to_vector('[0, 0]'),'EUCLIDEAN') DESC, limit input to 3 row(s) per chunk  (cost=1.25 rows=10) (actual time=X..Y rows=3 loops=1)
        -> Filter: (t2.flag = 1)  (cost=1.25 rows=10) (actual time=X..Y rows=5 loops=1)
            -> Table scan on t2  (cost=1.25 rows=10) (actual time=X..Y rows=10 loops=1)

# Case when vector search runs out of entries to return.
SELECT id FROM t2 WHERE flag= 0 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 6;
id
1
4
5
8
9
EXPLAIN ANALYZE SELECT id FROM t2 WHERE flag= 0 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 6;
EXPLAIN
-> Limit: 6 row(s)  (cost=1.25 rows=1) (actual time=X..Y rows=5 loops=1)
    -> Filter: (t2.flag = 0)  (cost=1.25 rows=1) (actual time=X..Y rows=5 loops=1)
        -> Vector index search on t2 using v  (cost=1.25 rows=1) (actual time=X..Y rows=10 loops=1)

DROP TABLE t2;
#
# Test that a distance function in where clause gets executed using HNSW index.
#
CREATE FUNCTION vector_to_pretty_string(v VECTOR) RETURNS TEXT DETERMINISTIC
RETURN regexp_replace(vector_to_string(v), '\\.0{5}e\\+00', '');
CREATE TABLE t2 (
id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR (3),
VECTOR KEY (v)
);
INSERT INTO t2 VALUES ( 1, to_vector('[0, 0, 0]') );
INSERT INTO t2 VALUES ( 2, to_vector('[1, 1, 1]') );
INSERT INTO t2 VALUES ( 3, to_vector('[1, 1, 2]') );
INSERT INTO t2 VALUES ( 4, to_vector('[1, 2, 1]') );
INSERT INTO t2 VALUES ( 5, to_vector('[1, 2, 2]') );
INSERT INTO t2 VALUES ( 6, to_vector('[2, 1, 1]') );
INSERT INTO t2 VALUES ( 7, to_vector('[2, 1, 2]') );
INSERT INTO t2 VALUES ( 8, to_vector('[2, 2, 1]') );
INSERT INTO t2 VALUES ( 9, to_vector('[2, 2, 2]') );
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(v) v, distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') FROM t2;
EXPLAIN
-> Table scan on t2  (cost=1.15 rows=9) (actual time=X..Y rows=9 loops=1)

SELECT id, vector_to_pretty_string(v) v, distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') FROM t2;
id	v	distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN')
1	[0,0,0]	0
2	[1,1,1]	1.7320507764816284
3	[1,1,2]	2.4494898319244385
4	[1,2,1]	2.4494898319244385
5	[1,2,2]	3
6	[2,1,1]	2.4494898319244385
7	[2,1,2]	3
8	[2,2,1]	3
9	[2,2,2]	3.464101552963257
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(v) v FROM t2 WHERE distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') <= 2;
EXPLAIN
-> Filter: (distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2)  (cost=1.15 rows=9) (actual time=X..Y rows=2 loops=1)
    -> Table scan on t2  (cost=1.15 rows=9) (actual time=X..Y rows=9 loops=1)

SELECT id, vector_to_pretty_string(v) v FROM t2 WHERE distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') <= 2;
id	v
1	[0,0,0]
2	[1,1,1]
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(v) v FROM t2 WHERE distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') <= 2.5;
EXPLAIN
-> Filter: (distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5)  (cost=1.15 rows=9) (actual time=X..Y rows=5 loops=1)
    -> Table scan on t2  (cost=1.15 rows=9) (actual time=X..Y rows=9 loops=1)

SELECT id, vector_to_pretty_string(v) v FROM t2 WHERE distance(v, to_vector('[0, 0, 0]'), 'EUCLIDEAN') <= 2.5;
id	v
1	[0,0,0]
2	[1,1,1]
3	[1,1,2]
4	[1,2,1]
6	[2,1,1]
# Joins
CREATE TABLE t3 (
id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR (3),
VECTOR KEY (v)
);
INSERT INTO t3 VALUES ( 1, to_vector('[0, 0, 0]') );
INSERT INTO t3 VALUES ( 2, to_vector('[1, 1, 1]') );
INSERT INTO t3 VALUES ( 3, to_vector('[1, 1, 2]') );
INSERT INTO t3 VALUES ( 4, to_vector('[1, 2, 1]') );
INSERT INTO t3 VALUES ( 5, to_vector('[1, 2, 2]') );
INSERT INTO t3 VALUES ( 6, to_vector('[2, 1, 1]') );
INSERT INTO t3 VALUES ( 7, to_vector('[2, 1, 2]') );
INSERT INTO t3 VALUES ( 8, to_vector('[2, 2, 1]') );
INSERT INTO t3 VALUES ( 9, to_vector('[2, 2, 2]') );
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(t2.v) v
FROM t2 join t3 using (id)
WHERE distance( t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
EXPLAIN
-> Nested loop inner join  (cost=4.3 rows=9) (actual time=X..Y rows=5 loops=1)
    -> Filter: (distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5)  (cost=1.15 rows=9) (actual time=X..Y rows=5 loops=1)
        -> Table scan on t2  (cost=1.15 rows=9) (actual time=X..Y rows=9 loops=1)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=0.261 rows=1) (actual time=X..Y rows=1 loops=5)

SELECT id, vector_to_pretty_string(t2.v) v
FROM t2 join t3 using (id)
WHERE distance( t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
id	v
1	[0,0,0]
2	[1,1,1]
3	[1,1,2]
4	[1,2,1]
6	[2,1,1]
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
EXPLAIN
-> Nested loop inner join  (cost=1.61 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Filter: ((distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5) and (t2.id < 3))  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
        -> Index range scan on t2 using PRIMARY over (id < 3)  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=0.3 rows=1) (actual time=X..Y rows=1 loops=2)

SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
id	v
1	[0,0,0]
2	[1,1,1]
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, t2.v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE 2.5 >= distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' );
EXPLAIN
-> Nested loop inner join  (cost=1.61 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Filter: ((2.5 >= distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN')) and (t2.id < 3))  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
        -> Index range scan on t2 using PRIMARY over (id < 3)  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=0.3 rows=1) (actual time=X..Y rows=1 loops=2)

SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE 2.5 >= distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' );
id	v
1	[0,0,0]
2	[1,1,1]
