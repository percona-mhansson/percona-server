t1	1	ix	1	v1	A	0	1	NULL	YES	VECTOR		Hnsw	YES	NULL
ALTER TABLE t1 DROP PRIMARY KEY;
ERROR HY000: Vector index can only be created in tables with a BIGINT UNSIGNED primary key.
ALTER TABLE t1 DROP INDEX ix;
