CREATE TABLE t1 (
a VECTOR(3)
);
CREATE VECTOR INDEX vi ON t1( a );
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` vector(3) DEFAULT NULL,
  VECTOR KEY `vi` (`a`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
